{
  "$schema": "https://schemas.wp.org/trunk/wp-env.json",
  "core": "https://wordpress.org/wordpress-7.1.4.zip",
  "phpVersion": "8.3",
  "plugins": [
    "./plugins/noempesquen-core",
    "https://downloads.wordpress.org/plugin/two-factor.latest-stable.zip",
    "https://downloads.wordpress.org/plugin/autodescription.latest-stable.zip"
  ],
  "themes": [ "./themes/noempesquen" ],
  "port": 8888,
  "testsPort": 8889,
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_LOG": true,
    "SCRIPT_DEBUG": true,
    "WPLANG": "ca"
  },
  "lifecycleScripts": {
    "afterStart": "wp-env run cli wp language core install ca --activate && wp-env run cli wp theme activate noempesquen && wp-env run cli wp rewrite structure /%postname%/"
  }
}
