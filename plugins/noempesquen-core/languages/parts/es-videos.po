msgid "Galeria de vídeos No em pesquen"
msgstr "Galería de vídeos No em pesquen"

#: src/blocks/galeria-videos/block.json
msgctxt "block description"
msgid "Llista de les pàgines de vídeo (filles de Vídeos) de l'idioma actual."
msgstr "Lista de las páginas de vídeo (hijas de Vídeos) del idioma actual."

#: src/blocks/video/block.json
msgctxt "block title"
msgid "Vídeo No em pesquen"
msgstr "Vídeo No em pesquen"

#: src/blocks/video/block.json
msgctxt "block description"
msgid "Vídeo propi amb subtítols en català i castellà, transcripció i enllaç a la missió del simulador."
msgstr "Vídeo propio con subtítulos en catalán y castellano, transcripción y enlace a la misión del simulador."

msgid "Encara no hi ha cap vídeo. Aquí hi trobaràs vídeos curts amb subtítols i transcripció que expliquen com detectar estafes digitals."
msgstr "Todavía no hay ningún vídeo. Aquí encontrarás vídeos cortos con subtítulos y transcripción que explican cómo detectar estafas digitales."

msgid "Mentrestant, prova el simulador"
msgstr "Mientras tanto, prueba el simulador"

msgid "Vídeos sobre estafes digitals amb subtítols"
msgstr "Vídeos sobre estafas digitales con subtítulos"

msgid "Vídeos curts amb subtítols i transcripció per aprendre a detectar estafes digitals abans que et pesquin. Després, practica al simulador."
msgstr "Vídeos cortos con subtítulos y transcripción para aprender a detectar estafas digitales antes de que te pesquen. Después, practica en el simulador."

msgid "Falta la transcripció: sense ella, la pàgina no cobreix l’alternativa en text del vídeo."
msgstr "Falta la transcripción: sin ella, la página no ofrece la alternativa en texto del vídeo."

msgid "Opcional: només es fa servir si WordPress no pot llegir la durada del fitxer MP4."
msgstr "Opcional: solo se usa si WordPress no puede leer la duración del archivo MP4."

msgid "Simulador d’estafes digitals"
msgstr "Simulador de estafas digitales"

msgid "Tots els vídeos"
msgstr "Todos los vídeos"

msgid "Simulador gratuït d’estafes digitals per aprendre a detectar-les, amb vídeos curts subtitulats."
msgstr "Simulador gratuito de estafas digitales para aprender a detectarlas, con vídeos cortos subtitulados."

msgid "Vídeos"
msgstr "Vídeos"
