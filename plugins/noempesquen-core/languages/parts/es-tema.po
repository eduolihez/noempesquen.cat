msgid "Vídeos"
msgstr "Vídeos"

#: themes/noempesquen/patterns/videos.php:16
msgctxt "tema"
msgid "Vídeos curts per aprendre a detectar estafes digitals abans que et pesquin."
msgstr "Vídeos cortos para aprender a detectar estafas digitales antes de que te pesquen."
