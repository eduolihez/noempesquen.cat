{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1200px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "gradients": [],
      "palette": [
        {
          "slug": "fons",
          "name": "Gel",
          "color": "#F2F6FB"
        },
        {
          "slug": "text",
          "name": "Tinta de port",
          "color": "#0B1E3F"
        },
        {
          "slug": "mar",
          "name": "Blau llotja",
          "color": "#0D3FA6"
        },
        {
          "slug": "port",
          "name": "Blau de port",
          "color": "#07245E"
        },
        {
          "slug": "escuma",
          "name": "Escuma",
          "color": "#DCE8F7"
        },
        {
          "slug": "alerta",
          "name": "Avís",
          "color": "#C8201E"
        },
        {
          "slug": "segur",
          "name": "Segur",
          "color": "#0F7B5F"
        },
        {
          "slug": "senyal",
          "name": "Número de lot",
          "color": "#FFD23F"
        },
        {
          "slug": "blanc",
          "name": "Etiqueta",
          "color": "#FFFFFF"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "rotulacio",
          "name": "Rotulació",
          "fontFamily": "\"Big Shoulders Display\", \"Arial Narrow\", Impact, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Big Shoulders Display",
              "fontWeight": "800",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/big-shoulders-display-latin-800-normal.woff2"
              ]
            },
            {
              "fontFamily": "Big Shoulders Display",
              "fontWeight": "900",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/big-shoulders-display-latin-900-normal.woff2"
              ]
            }
          ]
        },
        {
          "slug": "estarcit",
          "name": "Estarcit",
          "fontFamily": "\"Big Shoulders Stencil Display\", \"Big Shoulders Display\", Impact, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Big Shoulders Stencil Display",
              "fontWeight": "800",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/big-shoulders-stencil-display-latin-800-normal.woff2"
              ]
            }
          ]
        },
        {
          "slug": "text",
          "name": "Text",
          "fontFamily": "\"Atkinson Hyperlegible\", system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Atkinson Hyperlegible",
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/atkinson-hyperlegible-latin-400-normal.woff2"
              ]
            },
            {
              "fontFamily": "Atkinson Hyperlegible",
              "fontWeight": "700",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/atkinson-hyperlegible-latin-700-normal.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Petit",
          "size": "1rem"
        },
        {
          "slug": "medium",
          "name": "Mitjà",
          "size": "1.1875rem"
        },
        {
          "slug": "large",
          "name": "Gran",
          "size": "1.5rem",
          "fluid": {
            "min": "1.3rem",
            "max": "1.5rem"
          }
        },
        {
          "slug": "x-large",
          "name": "Molt gran",
          "size": "2.75rem",
          "fluid": {
            "min": "2rem",
            "max": "2.75rem"
          }
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "%",
        "vw"
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--fons)",
      "text": "var(--wp--preset--color--text)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--text)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--rotulacio)",
          "fontWeight": "800",
          "lineHeight": "1.05"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--mar)"
        },
        "typography": {
          "textDecoration": "underline"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--mar)",
          "text": "#FFFFFF"
        },
        "border": {
          "radius": "10px"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Capçalera",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Peu",
      "area": "footer"
    }
  ]
}
