#: src/blocks/compte/textos.js
msgid "Carregant el teu compte…"
msgstr "Cargando tu cuenta…"

#: src/blocks/compte/textos.js
msgid "Accés al compte"
msgstr "Acceso a la cuenta"

#: src/blocks/compte/textos.js
msgid "Crea un compte"
msgstr "Crea una cuenta"

#: src/blocks/compte/textos.js
msgid "Entra"
msgstr "Entra"

#: src/blocks/compte/textos.js
msgid "Contrasenya"
msgstr "Contraseña"

#: src/blocks/compte/textos.js
msgid "Entre 10 i 128 caràcters."
msgstr "Entre 10 y 128 caracteres."

#: src/blocks/compte/textos.js
msgid "Si perds la contrasenya, només la podràs recuperar si has verificat el correu. T'enviarem un missatge per fer-ho."
msgstr "Si pierdes la contraseña, solo podrás recuperarla si has verificado el correo. Te enviaremos un mensaje para hacerlo."

#: src/blocks/compte/textos.js
msgid "Tinc 14 anys o més"
msgstr "Tengo 14 años o más"

#: src/blocks/compte/textos.js
msgid "Accepto que es desin el meu correu i el meu progrés per poder recuperar-lo en un altre dispositiu"
msgstr "Acepto que se guarden mi correo y mi progreso para poder recuperarlo en otro dispositivo"

#: src/blocks/compte/textos.js
msgid "Quines dades es guarden"
msgstr "Qué datos se guardan"

#: src/blocks/compte/textos.js
msgid "Només el teu correu electrònic. L'usem per entrar i per enviar-te els missatges de verificació i de recuperació de la contrasenya, res més."
msgstr "Solo tu correo electrónico. Lo usamos para entrar y para enviarte los mensajes de verificación y de recuperación de la contraseña, nada más."

#: src/blocks/compte/textos.js
msgid "La contrasenya, guardada xifrada (amb hash): ningú no la pot llegir."
msgstr "La contraseña, guardada cifrada (con hash): nadie puede leerla."

#: src/blocks/compte/textos.js
msgid "El progrés de les missions (les estrelles de cada missió)."
msgstr "El progreso de las misiones (las estrellas de cada misión)."

#: src/blocks/compte/textos.js
msgid "La data i la versió del consentiment que acceptes ara."
msgstr "La fecha y la versión del consentimiento que aceptas ahora."

#: src/blocks/compte/textos.js
msgid "Res del que escriguis als formularis falsos del simulador: no surt mai del teu navegador."
msgstr "Nada de lo que escribas en los formularios falsos del simulador: no sale nunca de tu navegador."

#: src/blocks/compte/textos.js
msgid "Pots descarregar-ho i esborrar-ho tot des d'aquesta pàgina."
msgstr "Puedes descargarlo y borrarlo todo desde esta página."

#: src/blocks/compte/textos.js
msgid "Les estadístiques anònimes de les partides són a part i no porten cap dada teva."
msgstr "Las estadísticas anónimas de las partidas van aparte y no llevan ningún dato tuyo."

#: src/blocks/compte/textos.js
msgid "Crea el compte"
msgstr "Crea la cuenta"

#: src/blocks/compte/textos.js
msgid "Enviant…"
msgstr "Enviando…"

#: src/blocks/compte/textos.js
msgid "Escriu un correu electrònic vàlid."
msgstr "Escribe un correo electrónico válido."

#: src/blocks/compte/textos.js
msgid "Escriu la contrasenya."
msgstr "Escribe la contraseña."

#: src/blocks/compte/textos.js
msgid "Cal que tinguis 14 anys o més per crear un compte."
msgstr "Tienes que tener 14 años o más para crear una cuenta."

#: src/blocks/compte/textos.js
msgid "Cal que acceptis que es desin les dades per crear un compte."
msgstr "Tienes que aceptar que se guarden los datos para crear una cuenta."

#: src/blocks/compte/textos.js
msgid "Revisa els camps marcats."
msgstr "Revisa los campos marcados."

#: src/blocks/compte/textos.js
msgid "Compte creat. Ja tens la sessió iniciada."
msgstr "Cuenta creada. Ya has iniciado sesión."

#: src/blocks/compte/textos.js
msgid "Has entrat al teu compte."
msgstr "Has entrado en tu cuenta."

#: src/blocks/compte/textos.js
msgid "El teu compte"
msgstr "Tu cuenta"

#: src/blocks/compte/textos.js
msgid "Progrés de les missions"
msgstr "Progreso de las misiones"

#: src/blocks/compte/textos.js
msgid "Encara no hi ha cap missió desada. Juga al simulador amb la sessió iniciada."
msgstr "Todavía no hay ninguna misión guardada. Juega en el simulador con la sesión iniciada."

#: src/blocks/compte/textos.js
msgid "Ves al simulador"
msgstr "Ve al simulador"

#: src/blocks/compte/textos.js
msgid "Descarrega les meves dades"
msgstr "Descargar mis datos"

#: src/blocks/compte/textos.js
msgid "Dades descarregades."
msgstr "Datos descargados."

#: src/blocks/compte/textos.js
msgid "Tanca la sessió"
msgstr "Cerrar sesión"

#: src/blocks/compte/textos.js
msgid "Has tancat la sessió."
msgstr "Has cerrado la sesión."

#: src/blocks/compte/textos.js
msgid "Esborra el compte"
msgstr "Borrar la cuenta"

#: src/blocks/compte/textos.js
msgid "Esborrar el compte"
msgstr "Borrar la cuenta"

#: src/blocks/compte/textos.js
msgid "S'esborraran el teu correu, la contrasenya i el progrés. No es pot desfer."
msgstr "Se borrarán tu correo, la contraseña y el progreso. No se puede deshacer."

#: src/blocks/compte/textos.js
msgid "Esborra el compte definitivament"
msgstr "Borrar la cuenta definitivamente"

#: src/blocks/compte/textos.js
msgid "Cancel·la"
msgstr "Cancelar"

#: src/blocks/compte/textos.js
msgid "El compte s'ha esborrat."
msgstr "La cuenta se ha borrado."

#: src/blocks/compte/textos.js
msgid "He oblidat la contrasenya"
msgstr "He olvidado la contraseña"

#: src/blocks/compte/textos.js
msgid "Recupera la contrasenya"
msgstr "Recupera la contraseña"

#: src/blocks/compte/textos.js
msgid "Escriu el correu del teu compte. Si és d'un compte amb el correu verificat, t'hi enviarem un enllaç per triar una contrasenya nova."
msgstr "Escribe el correo de tu cuenta. Si es de una cuenta con el correo verificado, te enviaremos un enlace para elegir una contraseña nueva."

#: src/blocks/compte/textos.js
msgid "Envia'm l'enllaç"
msgstr "Envíame el enlace"

#: src/blocks/compte/textos.js
msgid "Si hi ha un compte amb aquest correu verificat, t'hem enviat un enllaç. Mira també la carpeta de correu brossa. L'enllaç caduca d'aquí a 1 hora."
msgstr "Si hay una cuenta con este correo verificado, te hemos enviado un enlace. Mira también la carpeta de correo no deseado. El enlace caduca dentro de 1 hora."

#: src/blocks/compte/textos.js
msgid "Torna a l'entrada"
msgstr "Volver a la entrada"

#: src/blocks/compte/textos.js
msgid "Tria una contrasenya nova"
msgstr "Elige una contraseña nueva"

#: src/blocks/compte/textos.js
msgid "Contrasenya nova"
msgstr "Contraseña nueva"

#: src/blocks/compte/textos.js
msgid "Desa la contrasenya nova"
msgstr "Guardar la contraseña nueva"

#: src/blocks/compte/textos.js
msgid "Contrasenya canviada. Ja pots entrar amb la nova."
msgstr "Contraseña cambiada. Ya puedes entrar con la nueva."

#: src/blocks/compte/textos.js
msgid "L'enllaç no és vàlid o ha caducat. Demana'n un de nou."
msgstr "El enlace no es válido o ha caducado. Pide uno nuevo."

#: src/blocks/compte/textos.js
msgid "Correu verificat. Gràcies!"
msgstr "Correo verificado. ¡Gracias!"

#: src/blocks/compte/textos.js
msgid "Verifica el correu"
msgstr "Verifica el correo"

#: src/blocks/compte/textos.js
msgid "T'hem enviat un enllaç per confirmar el correu. Sense verificar, no podràs recuperar la contrasenya si la perds. El compte funciona igualment."
msgstr "Te hemos enviado un enlace para confirmar el correo. Sin verificar, no podrás recuperar la contraseña si la pierdes. La cuenta funciona igualmente."

#: src/blocks/compte/textos.js
msgid "Reenvia el correu"
msgstr "Reenviar el correo"

#: src/blocks/compte/textos.js
msgid "T'hem tornat a enviar el correu. Mira també la carpeta de correu brossa."
msgstr "Te hemos vuelto a enviar el correo. Mira también la carpeta de correo no deseado."

#: src/blocks/compte/textos.js
msgid "No s'ha pogut enviar el correu. Torna-ho a provar més tard."
msgstr "No se ha podido enviar el correo. Vuelve a intentarlo más tarde."

#: src/blocks/contacte/textos.js
msgid "Escriu-nos"
msgstr "Escríbenos"

#: src/blocks/contacte/textos.js
msgid "Tots els camps són obligatoris."
msgstr "Todos los campos son obligatorios."

#: src/blocks/contacte/textos.js
msgid "Nom"
msgstr "Nombre"

#: src/blocks/contacte/textos.js
msgid "Només el farem servir per respondre’t."
msgstr "Solo lo usaremos para responderte."

#: src/blocks/contacte/textos.js
msgid "Assumpte"
msgstr "Asunto"

#: src/blocks/contacte/textos.js
msgid "Tria un assumpte"
msgstr "Elige un asunto"

#: src/blocks/contacte/textos.js
msgid "Missatge"
msgstr "Mensaje"

#: src/blocks/contacte/textos.js
msgid "Entre 10 i 2000 caràcters."
msgstr "Entre 10 y 2000 caracteres."

#: src/blocks/contacte/textos.js
msgid "He llegit l’"
msgstr "He leído el "

#: src/blocks/contacte/textos.js
msgid "avís de privacitat"
msgstr "aviso de privacidad"

#: src/blocks/contacte/textos.js
msgid "i accepto que s’usin aquestes dades per respondre’m"
msgstr "y acepto que se usen estos datos para responderme"

#: src/blocks/contacte/textos.js
msgid "Envia el missatge"
msgstr "Enviar el mensaje"

#: src/blocks/contacte/textos.js
msgid "S’està enviant…"
msgstr "Enviando…"

#: src/blocks/contacte/textos.js
msgid "Revisa el formulari"
msgstr "Revisa el formulario"

#: src/blocks/contacte/textos.js
msgid "No s’ha pogut enviar el missatge. Torna-ho a provar d’aquí una estona."
msgstr "No se ha podido enviar el mensaje. Vuelve a intentarlo dentro de un rato."

#: src/blocks/contacte/textos.js
msgid "Has enviat massa missatges. Torna-ho a provar una mica més tard."
msgstr "Has enviado demasiados mensajes. Vuelve a intentarlo un poco más tarde."

#: src/blocks/contacte/textos.js
msgid "Missatge enviat"
msgstr "Mensaje enviado"

#: src/blocks/contacte/textos.js
msgid "Gràcies! Hem rebut el teu missatge i et respondrem tan aviat com puguem."
msgstr "¡Gracias! Hemos recibido tu mensaje y te responderemos en cuanto podamos."

#: src/blocks/contacte/textos.js
msgid "Dubte"
msgstr "Duda"

#: src/blocks/contacte/textos.js
msgid "Suggeriment"
msgstr "Sugerencia"

#: src/blocks/contacte/textos.js
msgid "He trobat un error"
msgstr "He encontrado un error"

#: src/blocks/contacte/textos.js
msgid "Altres"
msgstr "Otros"

#: src/blocks/contacte/textos.js
msgid "Escriu el teu nom."
msgstr "Escribe tu nombre."

#: src/blocks/contacte/textos.js
msgid "El nom no pot passar de 80 caràcters."
msgstr "El nombre no puede pasar de 80 caracteres."

#: src/blocks/contacte/textos.js
msgid "Escriu el teu correu electrònic."
msgstr "Escribe tu correo electrónico."

#: src/blocks/contacte/textos.js
msgid "Escriu un correu vàlid, per exemple nom@exemple.cat."
msgstr "Escribe un correo válido, por ejemplo nombre@ejemplo.es."

#: src/blocks/contacte/textos.js
msgid "Tria un assumpte de la llista."
msgstr "Elige un asunto de la lista."

#: src/blocks/contacte/textos.js
msgid "Escriu el teu missatge."
msgstr "Escribe tu mensaje."

#: src/blocks/contacte/textos.js
msgid "El missatge ha de tenir almenys 10 caràcters."
msgstr "El mensaje debe tener al menos 10 caracteres."

#: src/blocks/contacte/textos.js
msgid "El missatge no pot passar de 2000 caràcters."
msgstr "El mensaje no puede pasar de 2000 caracteres."

#: src/blocks/contacte/textos.js
msgid "Cal que acceptis l’avís de privacitat per poder enviar el missatge."
msgstr "Tienes que aceptar el aviso de privacidad para poder enviar el mensaje."

#. translators: %d: nombre d'estrelles (de 3).
#: src/blocks/compte/textos.js
#, php-format
msgid "%d estrella de 3"
msgid_plural "%d estrelles de 3"
msgstr[0] "%d estrella de 3"
msgstr[1] "%d estrellas de 3"
